{
	"extends": "https://raw.githubusercontent.com/kjanat/kjanat/85bf2eb4/configs/dprint.remote.json",
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{ "command": "tombi format - --stdin-filename {{file_path}}", "exts": ["toml"], "cacheKeyFiles": ["tombi.toml"] }
		]
	},
	"excludes": ["**/*.lock"],
	"plugins": [
		"https://plugins.dprint.dev/exec-0.7.3.json@a7898d5f1897e77bff474cec3d948c3ec3a7f455e32de2cc60c8adb9a5dd24aa"
	]
}
